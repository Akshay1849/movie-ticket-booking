generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
  THEATRE_MANAGER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SeatCategory {
  BALCONY
  FIRST_CLASS
}

enum MovieStatus {
  NOW_SHOWING
  UPCOMING
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum ShowStatus {
  ACTIVE
  CANCELLED
}

model Theatre {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  screens Screen[]
}

model Screen {
  id        String   @id @default(uuid())
  name      String
  theatreId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  theatre Theatre @relation(fields: [theatreId], references: [id], onDelete: Restrict)
  seats   Seat[]
  shows   Show[]

  @@unique([theatreId, name])
}

model Seat {
  id         String       @id @default(uuid())
  screenId   String
  seatCode   String
  category   SeatCategory
  row        String?
  seatNumber Int?
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  screen       Screen        @relation(fields: [screenId], references: [id], onDelete: Restrict)
  bookingSeats BookingSeat[]

  @@unique([screenId, seatCode])
}

model Movie {
  id          String      @id @default(uuid())
  title       String
  description String?
  posterUrl   String?
  trailerUrl  String?
  duration    Int
  genre       String
  language    String
  status      MovieStatus @default(UPCOMING)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  shows Show[]
}

model Show {
  id        String     @id @default(uuid())
  movieId   String
  screenId  String
  showDate  DateTime   @db.Date
  startTime DateTime   @db.Time(0)
  status    ShowStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  movie        Movie         @relation(fields: [movieId], references: [id], onDelete: Restrict)
  screen       Screen        @relation(fields: [screenId], references: [id], onDelete: Restrict)
  prices       ShowPrice[]
  bookings     Booking[]
  bookingSeats BookingSeat[]

  @@unique([screenId, showDate, startTime])
}

model ShowPrice {
  id        String       @id @default(uuid())
  showId    String
  category  SeatCategory
  amount    Decimal      @db.Decimal(10, 2)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  show Show @relation(fields: [showId], references: [id], onDelete: Cascade)

  @@unique([showId, category])
}

model User {
  id           String     @id @default(uuid())
  email        String?    @unique
  mobile       String?    @unique
  passwordHash String?
  role         UserRole   @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  bookings Booking[]
}

model Booking {
  id               String        @id @default(uuid())
  bookingReference String        @unique
  userId           String
  showId           String
  status           BookingStatus @default(PENDING)
  totalAmount      Decimal       @db.Decimal(10, 2)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user  User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  show  Show          @relation(fields: [showId], references: [id], onDelete: Restrict)
  seats BookingSeat[]
}

model BookingSeat {
  id        String   @id @default(uuid())
  bookingId String
  showId    String
  seatId    String
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  show    Show    @relation(fields: [showId], references: [id], onDelete: Restrict)
  seat    Seat    @relation(fields: [seatId], references: [id], onDelete: Restrict)

  @@unique([showId, seatId])
}
